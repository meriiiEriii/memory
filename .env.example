# Memory Lane - environment template.
# Copy this file to ".env" and paste your own token in.
# NEVER commit the real .env file - it is already listed in .gitignore.

# Replicate API token - create/rotate at https://replicate.com/account/api-tokens
# Only needed for the cloud AI features (/enhance and /cloud-restore).
# Without it the app still runs; server.js returns a readable error instead of
# calling the API, and the offline editor works completely unaffected.
REPLICATE_API_TOKEN=